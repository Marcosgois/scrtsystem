# ── Banco de dados ─────────────────────────────────────────────────────────
# Por padrão (sem MONGODB_URI), o TFPSystem sobe um MongoDB local persistente
# com os dados gravados em ./data/mongodb, dentro da própria pasta do app.
#
# Para usar outro banco (Atlas ou servidor próprio), descomente e configure:
# MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/tfpsystem
# MONGODB_URI=mongodb://127.0.0.1:27017/tfpsystem
#
# Porta do MongoDB local (mude se a 27017 já estiver em uso):
# LOCAL_DB_PORT=27017

PORT=3000

# ── Log de acesso ──────────────────────────────────────────────────────────
# Uma linha por requisição no terminal e em data/logs/app-AAAA-MM-DD.log,
# com quem acessou (e-mail), o que pediu, o status e o tempo. Também registra
# login/logout, criação do 1º admin e tentativas negadas por falta de acesso.
#
# LOG_REQUESTS=all    # all (padrão) | api (só /api) | off
# LOG_STATIC=1        # inclui css/js/imagens (poluído; desligado por padrão)
# LOG_FILE=0          # só terminal, sem gravar arquivo
# LOG_AUTH=0          # silencia login/logout/negados (ligado por padrão)
# LOG_DIR=./data/logs
