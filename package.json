  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0"
