    "demo": "node scripts/demo.js",
    "test:parser": "node test/parser.test.js",
    "test:e2e": "node test/e2e.test.js",
    "test:migration": "node test/migration.test.js",
    "test:auth": "node test/auth.test.js",
    "test:audit": "node test/audit.test.js",
    "test:security": "node test/security.test.js",
    "test:infra-lspr": "node test/infra-lspr.test.js",
    "test:contratos": "node test/contratos.test.js",
    "test:forecast": "node test/forecast.test.js",
    "test:deck": "node test/deck.test.js",
    "test:mlc": "node test/mlc.test.js",
    "test:mlc-views": "node test/mlc-views.test.js",
    "test:contract-periods": "node test/contract-periods.test.js",
